{
  "name": "circuit-forge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently \"tsx watch server/index.ts\" \"vite --host 127.0.0.1\"",
    "build": "tsc --noEmit && vite build",
    "start": "tsx server/index.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src server tests scripts",
    "format": "prettier --write src server tests scripts",
    "cli": "node --import tsx scripts/cli.ts",
    "examples": "node --import tsx scripts/generate-examples.ts",
    "bench": "node --import tsx scripts/benchmark.ts",
    "test:browser": "node --import tsx scripts/browser-check.ts",
    "test:protocol": "node --import tsx scripts/protocol-check.ts",
    "test:export": "node --import tsx scripts/export-check.ts",
    "evidence": "node --import tsx scripts/evidence.ts"
  },
  "dependencies": {
    "@xyflow/react": "12.8.6",
    "express": "5.1.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "ws": "8.22.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/express": "5.0.3",
    "@types/node": "24.9.1",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@types/ws": "8.18.1",
    "concurrently": "9.2.5",
    "eslint": "10.13.0",
    "prettier": "3.9.10",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0",
    "vite": "7.3.7",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": ">=24.18.0"
  }
}
